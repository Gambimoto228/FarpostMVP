# Прод-окружение для docker-compose.prod.yml
# Скопировать в .env на сервере и заполнить. В git не коммитить.

# Домен для Caddy (A-запись должна указывать на этот сервер).
DOMAIN=domdose.example.com

# Email для Let's Encrypt.
ACME_EMAIL=admin@example.com

# Backend
APP_ENV=production
DATABASE_URL=sqlite:////data/domdose.db

# Origin фронтенда, которому разрешён доступ к API.
CORS_ORIGINS=https://domdose.example.com
